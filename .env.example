# ============================================================================
# Compliance Intelligence Copilot — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# --- LLM provider -----------------------------------------------------------
# "groq" (default, hosted) or "ollama" (fully offline, no API key)
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys. Required when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama — https://ollama.com. Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct

LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.0
LLM_MAX_ANSWER_TOKENS=1200

# --- embeddings -------------------------------------------------------------
# Local, CPU, free. See README §8.2 for why bge-small is the default.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# BGE is trained asymmetrically: queries get an instruction prefix, passages do not.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBEDDING_BATCH_SIZE=32

# --- retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_POOL=30
RRF_K=60
RRF_DENSE_WEIGHT=1.0
RRF_SPARSE_WEIGHT=1.0
CONTEXT_MAX_TOKENS=3000
DEDUP_SIMILARITY_THRESHOLD=0.97

# --- reranking --------------------------------------------------------------
# ON by default because the golden set measured a material win (README DR-7):
#   recall@1 0.774 -> 0.870 | MRR 0.776 -> 0.863 | nDCG@5 0.781 -> 0.845
# TOP_N=10 because reranking the fused top-10 scored identically to top-30 at ~4x less
# latency (566 ms vs 2216 ms p50 on CPU). Downloads ~90 MB on first use.
# Set RERANK_ENABLED=false to reproduce the RRF-only baseline exactly.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=10

# --- evidence thresholds (calibrated against the golden set) ----------------
EVIDENCE_REFUSAL_FLOOR=0.30
EVIDENCE_MODERATE_FLOOR=0.45
EVIDENCE_STRONG_FLOOR=0.60

# --- storage ----------------------------------------------------------------
DATA_DIR=./data
AUDIT_LOG_PATH=./audit.log

# --- uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_FILES=10
MAX_PDF_PAGES=500

# --- server / security ------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Leave empty to run the API open (local development only). Set a long random
# value to require `X-API-Key` on mutating routes.
API_KEY=
API_KEY_ROLE=admin
# Public demo mode: callers without a key become read-only viewers (chat, browse)
# instead of being rejected; writes still need API_KEY. With API_KEY empty nobody
# can write. Used by the Hugging Face Space image.
PUBLIC_READ=false
# Origins allowed to embed the UI in an iframe, e.g. https://huggingface.co.
# Unset keeps X-Frame-Options: DENY.
# FRAME_ANCESTORS=https://huggingface.co
# Directory of a built frontend for the API to serve itself (single-container
# deployments). Unset when nginx or Vite serves the UI.
# STATIC_DIR=/app/static
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=10
MAX_QUESTION_CHARS=4000

# --- observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
# Full question text lives in audit.log by design; app logs get a hash only.
LOG_QUESTIONS=false


# compose -f docker-compose.yml up -d
# & "C:\Program Files (x86)\cloudflared\cloudflared.exe" tunnel --url http://localhost:3000