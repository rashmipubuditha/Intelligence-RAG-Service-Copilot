# =============================================================================
# Build context exclusions.
#
# Both images build from the repository root (the backend needs backend/, eval/,
# policies/ and main.py; the frontend needs frontend/), so one .dockerignore
# governs both. Keeping the context small matters: .venv and node_modules alone
# are well over a gigabyte and would be uploaded to the daemon on every build.
# =============================================================================

# secrets — must never enter an image layer
.env
.env.local
*.key

# virtualenvs and node modules (reinstalled inside the image)
.venv/
venv/
env/
node_modules/
frontend/node_modules/

# python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# generated state: the container builds its own index on a volume
data/
audit.log
audit.*.log

# build output (the frontend is compiled inside the image)
frontend/dist/
frontend/.vite/
build/
dist/

# evaluation reports — regenerated by running the harness
eval/reports/*.json
eval/reports/*.md

# docs, screenshots and the generated reference document
docs/
assets/
*.docx
Example pictures/

# version control and CI
.git/
.github/
.gitignore

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# docker files themselves
docker-compose*.yml
**/Dockerfile
.dockerignore
